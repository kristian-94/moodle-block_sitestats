{{!
    @template block_sitestats/main

    Site statistics: four stat tiles, then the top courses and the most recently added
    courses as two lists. Layout only; colours and fonts come from the theme.

    Example context (json):
    {
        "total_active_users": 1294,
        "number_of_courses": 105,
        "total_enrolments": 7261,
        "total_completions": 4460,
        "topcourseslimit": 10,
        "top_courses": [{"link": "#", "fullname": "HAZARDOUS WASTE 101", "track": "B - Hazardous Waste", "enrolments": 210}],
        "new_courses": [{"link": "#", "fullname": "UST LEAK PREVENTION UPDATE 2026", "track": "C - Underground Storage Tanks", "enrolments": 9}]
    }
}}
<div class="sitestats">
    <div class="sitestats-tiles">
        <div class="sitestats-tile card">
            <i class="fa fa-users" aria-hidden="true"></i>
            <strong>{{total_active_users}}</strong>
            <span>Total Active Users</span>
        </div>
        <div class="sitestats-tile card">
            <i class="fa fa-book" aria-hidden="true"></i>
            <strong>{{number_of_courses}}</strong>
            <span>Number of Courses</span>
        </div>
        <div class="sitestats-tile card">
            <i class="fa fa-user-plus" aria-hidden="true"></i>
            <strong>{{total_enrolments}}</strong>
            <span>Total Enrollments</span>
        </div>
        <div class="sitestats-tile card">
            <i class="fa fa-award" aria-hidden="true"></i>
            <strong>{{total_completions}}</strong>
            <span>Total Completions</span>
        </div>
    </div>

    <div class="sitestats-panels">
        <div class="sitestats-panel card">
            <div class="sitestats-panel-header card-header"><h5>Current top {{topcourseslimit}} courses</h5></div>
            <ul class="sitestats-list">
                {{#top_courses}}
                <li>
                    <a class="sitestats-link" href="{{link}}">
                        <span class="sitestats-icon" aria-hidden="true"><i class="fa fa-trophy"></i></span>
                        <span class="sitestats-text">
                            <strong>{{fullname}}</strong>
                            <small>{{track}} · {{enrolments}} enrollments</small>
                        </span>
                    </a>
                </li>
                {{/top_courses}}
            </ul>
        </div>
        <div class="sitestats-panel card">
            <div class="sitestats-panel-header card-header"><h5>{{topcourseslimit}} most recently added courses</h5></div>
            <ul class="sitestats-list">
                {{#new_courses}}
                <li>
                    <a class="sitestats-link" href="{{link}}">
                        <span class="sitestats-icon sitestats-icon-new" aria-hidden="true">NEW</span>
                        <span class="sitestats-text">
                            <strong>{{fullname}}</strong>
                            <small>{{track}} · {{enrolments}} enrollments</small>
                        </span>
                    </a>
                </li>
                {{/new_courses}}
            </ul>
        </div>
    </div>
</div>
